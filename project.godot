; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is still useful to know what the file contains.
; Project: OBSIDIAN - vertical slice (Nova Aetheris + The Spire Ruins)

config_version=5

[application]

config/name="Obsidian"
config/description="Vertical slice prototype: Nova Aetheris (city, driving, smartphone) and The Spire Ruins (class combat arena)."
run/main_scene="res://scenes/city/NovaAetheris.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
RankManager="*res://scripts/autoload/RankManager.gd"
JobManager="*res://scripts/autoload/JobManager.gd"
RankModal="*res://scenes/ui/RankModal.tscn"
Session="*res://scripts/autoload/Session.gd"
Valet="*res://scripts/autoload/Valet.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/fps=30
movie_writer/mjpeg_quality=0.92

[input]

